# Copy to .env.local for local development. Never commit the real values —
# .env.local is gitignored, and in production these live in Static Web Apps
# application settings instead.
#
# Leave these unset locally and the app serves the fixtures in
# lib/places/fixtures.ts. In production, missing values are a hard error rather
# than a silent fall back to fixtures.

COSMOS_ENDPOINT=
# Use the read-only key while the app only reads. Submissions in M4 will need a
# read-write one: az cosmosdb keys list -g rg-traversee -n <account> --type keys
COSMOS_KEY=
COSMOS_DATABASE=traversee

# Azure Maps. The account has local authentication disabled, so a subscription
# key will not work and is not an option here — /api/maps-token exchanges these
# for a short-lived Entra token that the browser uses for tile requests.
# The service principal holds only Azure Maps Data Reader, scoped to the one
# account. AZURE_MAPS_CLIENT_ID is the Maps account's uniqueId, not a secret:
# az maps account show -g rg-traversee -n map-traversee --query properties.uniqueId
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_MAPS_CLIENT_ID=
