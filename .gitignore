# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Editors / IDEs
.vscode/
.idea/
*.swp
*.swo
*~
.claude/

# Environment variables (never commit secrets)
.env
.env.local
.env.*.local
.env.development
.env.production

# Node.js
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
dist/
build/
.next/
out/

# Generated by `next build`; regenerated on every build, never edited by hand
next-env.d.ts
*.tsbuildinfo

# Python
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
.pytest_cache/

# Logs & tmp
*.log
tmp/
temp/

# Coverage
coverage/
.nyc_output/

# Copied from node_modules by scripts/copy-maplibre-worker.mjs at build time.
# Not committed: vendored copies drift out of step with the installed version.
public/maplibre/

# Scratch from the design tooling: a surface brief that goes stale the moment
# the page changes, and a build queue. Neither describes the shipped site, and a
# stale description is worse than none.
.impeccable/

# Hero footage. Git keeps every blob forever, so a 12 MB placeholder clip would
# still be in the history after it is replaced — and then so would its
# replacement. Video is served from Blob Storage instead; see
# public/hero/PROVENANCE.md for what is expected here and where it comes from.
public/hero/*.mp4
